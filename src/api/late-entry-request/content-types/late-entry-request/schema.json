{
  "kind": "collectionType",
  "collectionName": "late_entry_requests",
  "info": {
    "singularName": "late-entry-request",
    "pluralName": "late-entry-requests",
    "displayName": "Late Entry Request"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "reason": {
      "type": "text"
    },
    "destination": {
      "type": "string"
    },
    "emergencyContact": {
      "type": "string"
    },
    "expectedreturntime": {
      "type": "datetime"
    },
    "stat": {
      "type": "enumeration",
      "enum": ["pending", "approved", "rejected", "entered"],
      "default": "pending"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "approvedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "approvedAt": {
      "type": "datetime"
    },
    "enteredAt": {
      "type": "datetime"
    }
  }
}
