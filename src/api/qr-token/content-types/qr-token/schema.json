{
  "kind": "collectionType",
  "collectionName": "qr_tokens",
  "info": {
    "singularName": "qr-token",
    "pluralName": "qr-tokens",
    "displayName": "qr-token"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "token": {
      "type": "string",
      "unique": true,
      "required": true,
      "maxLength": 12,
      "minLength": 10
    },
    "hash": {
      "type": "text"
    },
    "expires_at": {
      "type": "datetime",
      "required": true
    },
    "consumed": {
      "type": "boolean",
      "default": false
    },
    "consumedAt": {
      "type": "datetime"
    },
    "consumed_by": {
      "type": "enumeration",
      "enum": [
        "gate",
        "system"
      ]
    },
    "exit_requests": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::exit-request.exit-request"
    }
  }
}